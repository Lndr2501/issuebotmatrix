# --- Matrix-Zugang (eigener Account, z. B. @issuebot:example.org) -------------
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER=@issuebot:example.org
# Passwort ODER Token. Beim Passwort-Login merkt sich der Bot den Token in /data.
MATRIX_PASSWORD=
MATRIX_TOKEN=
MATRIX_DEVICE_ID=issuebot
# Raeume, die der Bot beim Start betritt (optional, kommagetrennt). Sonst: einladen.
MATRIX_ROOMS=
ENCRYPTION_ENABLED=true

# --- GitHub -------------------------------------------------------------------
# Fine-grained Token: nur die Ziel-Repos, Berechtigung "Issues: Read and write".
GITHUB_TOKEN=
# Kurzname=owner/repo, kommagetrennt. Der erste ist das Standard-Repo.
# Anderes Repo im Chat: !issue musik: Titel | Beschreibung
ISSUE_REPOS=diddy=owner/diddy,musik=owner/musikbotmatrix
# Labels fuer jedes Issue (kommagetrennt). !bug setzt zusaetzlich "bug", !idee "enhancement".
ISSUE_LABELS=matrix
# Was im Issue ueber den Melder steht: name (Anzeigename + Matrix-ID), id (nur Matrix-ID), off
REPORTER_IN_ISSUE=name

# --- Wer darf? ------------------------------------------------------------------
# Leer = alle in den Raeumen des Bots. Sonst kommagetrennte Matrix-IDs
# (gilt dann auch fuer Einladungen).
ALLOWED_USERS=
# Einladungen nur von diesen Servern annehmen. Leer = nur der eigene Server des Bots.
INVITE_SERVERS=
# Hoechstens <Anzahl> Issues pro Person in <Sekunden>
RATE_LIMIT=5/600

# --- Sonstiges ------------------------------------------------------------------
BOT_PREFIX=!
LOG_LEVEL=INFO
DATA_DIR=/data
# Nur fuer GitHub Enterprise oder Tests:
#GITHUB_API_URL=https://api.github.com

# --- KI-Recherche (optional) ----------------------------------------------------
# Nach dem Anlegen liest eine OpenAI-kompatible KI das Issue, sucht passende Codestellen im
# aktuellen Repo-Stand und schreibt eine saubere Fassung ins Issue (Original bleibt aufklappbar).
# Leer = aus. Beispiel: http://192.168.1.10:8000/v1  (Ollama: http://host:11434/v1)
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Sekunden pro KI-Anfrage (lokale Modelle sind langsam)
AI_TIMEOUT=300
# Wie viel Code (Zeichen) die KI zu sehen bekommt; kleiner bei kleinem Kontextfenster
AI_CONTEXT_CHARS=24000
# Titel durch den KI-Titel ersetzen (Original steht unten im Issue)
AI_REWRITE_TITLE=true
# Denkstufe fuer Reasoning-Modelle (reasoning_effort): leer = nicht senden, sonst none/low/medium/high.
# Suchbegriffe: "low", Aufbereitung: diese Stufe. "none" schaltet Denken fuer beide aus.
AI_REASONING=
# Ausgabe-Tokens inkl. Denken
AI_MAX_TOKENS=12000
